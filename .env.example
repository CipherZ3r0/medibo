# ============================================
# medibo - Environment Configuration
# ============================================
# Copy this file to .env and adjust values:
#   cp .env.example .env

# --- LLM Provider ---
# Choose between "groq" (cloud, default) and "ollama" (local/offline).
LLM_PROVIDER=groq

# --- Groq LLM API ---
GROQ_API_KEY=your_groq_api_key_here
# Supported models: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
LLM_MODEL=qwen/qwen3.8-27b

# --- Ollama (local / offline LLM) ---
# Required only when LLM_PROVIDER=ollama.
# For LOCAL development : OLLAMA_BASE_URL=http://localhost:11434
# For DOCKER deployment : OLLAMA_BASE_URL=http://ollama:11434  (Docker service name)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Local Embeddings (sentence-transformers) ---
# The model is downloaded from Hugging Face on first run and cached locally.
# No API key or rate limit applies — inference runs 100% on your machine.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Elasticsearch ---
# For LOCAL development : http://localhost:9200
# For DOCKER deployment : http://elasticsearch:9200  (Docker service name)
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=potbot_documents

# --- Medical knowledge base (Phase 6) ---
# Default corpus: pre-built, protected, never written or cleared by the app.
MEDICAL_DEFAULT_INDEX=medibo_default
# User dataset: written by "Ingest Files", deleted by "Clear my data".
MEDICAL_USER_INDEX=medibo_user
# Comma-separated read set used for retrieval by the Streamlit app.
MEDICAL_RETRIEVAL_INDEXES=medibo_default,medibo_user
# Index that receives uploaded files.
MEDICAL_UPLOAD_INDEX=medibo_user

# --- Evidence gate (Phase 7) ---
# Decides whether an answer is grounded: trusted (curated KB), user (your uploads), none.
EVIDENCE_POLICY_NAME=evidence-v1
# Minimum supporting documents required for a grounded answer.
EVIDENCE_MIN_RELEVANT_DOCS=1
# CrossEncoder relevance threshold (ms-marco-MiniLM-L-6-v2 logit):
# relevant docs score ~+4.8..+7.4, irrelevant ~-7.6..-11.2.
EVIDENCE_MIN_RERANK_SCORE=1.0
# Cosine similarity threshold used only when reranking is disabled:
# relevant ~0.68..0.75, irrelevant ~0.19..0.32.
EVIDENCE_MIN_SIMILARITY=0.60

# --- PostgreSQL (feedback & monitoring) ---
# For LOCAL development : localhost
# For DOCKER deployment : postgres  (Docker service name)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=potbot
POSTGRES_USER=potbot
POSTGRES_PASSWORD=potbot_secret

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Application ---
STREAMLIT_PORT=8501
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
RERANK_TOP_N=3

# ============================================
# Ingestion Pipeline — Performance Tuning
# ============================================
# All values are safe to leave at their defaults.
# Tune these if you are ingesting large datasets on a powerful machine.

# --- Parallelism ---
# ThreadPoolExecutor workers for I/O-bound file loading (PDF, DOCX, etc.)
INGESTION_LOADER_WORKERS=4
# ProcessPoolExecutor workers for CPU-bound text chunking
# Keep at or below physical core count to avoid thrashing
INGESTION_CHUNKER_WORKERS=2
# Chunks per embedding inference call (larger = faster on GPU, more RAM)
INGESTION_EMBED_BATCH_SIZE=64
# Chunks per Elasticsearch bulk/_bulk API call
INGESTION_INDEX_BULK_SIZE=200
# Max items buffered in the inter-stage queue (0 = unlimited)
INGESTION_QUEUE_SIZE=500

# --- Device Selection ---
# Compute device for embedding inference
# Options: auto (detect CUDA -> MPS -> CPU) | cuda | mps | cpu
INGESTION_DEVICE=auto

# --- Incremental Ingestion ---
# SQLite file used to store per-file SHA-256 hashes and run checkpoints
INGESTION_CHECKPOINT_PATH=.ingestion_state.db

# --- Embedding Cache ---
# Whether to cache embeddings to avoid re-embedding unchanged chunks
EMBED_CACHE_ENABLED=true
# SQLite file used to store the embedding cache
EMBED_CACHE_PATH=.embed_cache.db
# LRU eviction limit (number of chunk entries). <= 0 means unlimited.
EMBED_CACHE_MAX_ENTRIES=100000
